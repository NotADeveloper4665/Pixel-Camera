<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <queries><package android:name="com.google.android.GoogleCamera" /></queries>
    <application android:label="Pixel 9a Fusion" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:supportsRtl="true">
        <activity android:name="org.eclipse.pixelcamera.fusion.FusionActivity"
            android:label="Pixel 9a Fusion" android:exported="true"
            android:screenOrientation="portrait" android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
